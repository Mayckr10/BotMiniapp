# ── Telegram ────────────────────────────────────────────────
BOT_TOKEN=123456:SEU_TOKEN_DO_BOTFATHER
# IDs numéricos dos admins (criadora), separados por vírgula
ADMIN_IDS=111111111
# ID do Canal de Amostras (o bot precisa ser ADMIN do canal)
CHANNEL_ID=-1001234567890

# Canal PRIVADO dos assinantes VIP (o bot precisa ser admin com permissão de convidar e banir)
VIP_CHANNEL_ID=-1009876543210

# ── Criadora ────────────────────────────────────────────────
# Para outra criadora: copie a pasta, troque estes valores e o BOT_TOKEN/canais acima.
CRIADORA_NOME=Criadora
# Planos criados na primeira execução (depois, ajuste com /plano no bot). Formato Nome:dias:preço
PLANOS_PADRAO=Mensal:30:29,90;Trimestral:90:79,90;Semestral:180:149,90
ASSINATURA_AVISO_DIAS=3          # avisa o assinante X dias antes de vencer
GORJETA_VALORES=10,25,50,100     # botões de gorjeta (R$)

# Deixe vazio em produção. O simulador usa http://localhost:8081
TELEGRAM_API_BASE=

# ── Servidor de webhook (pagamentos) ────────────────────────
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# URL pública (https) que o gateway vai chamar, ex: https://meudominio.com
PUBLIC_BASE_URL=http://localhost:8080
# Segredo compartilhado com o gateway (validado no header)
WEBHOOK_SECRET=troque-este-segredo

# ── PIX ─────────────────────────────────────────────────────
# mock | pushinpay
PIX_GATEWAY=mock
PUSHINPAY_TOKEN=
PIX_CHAVE_MOCK=contato@exemplo.com
PIX_NOME_RECEBEDOR=CRIADORA DE CONTEUDO
PIX_CIDADE_RECEBEDOR=SAO PAULO

# ── Venda ───────────────────────────────────────────────────
PIX_VALIDADE_MINUTOS=60          # depois disso o PIX expira e o cliente ganha o botão "Gerar novo PIX"
EXIGIR_MAIORIDADE=1              # pede confirmação 18+ antes da primeira compra
TERMOS_URL=                      # opcional: link dos seus termos de uso, mostrado na confirmação 18+

# ── Mini App (loja dentro do Telegram) ───────────────────────
LOJA_ATIVA=1                     # botão "🛍️ Loja" no bot (precisa de PUBLIC_BASE_URL em https)

# ── Backup ──────────────────────────────────────────────────
BACKUP_ATIVO=1
BACKUP_HORA=4                    # todo dia às 4h (FUSO_HORARIO) o .db vai para o privado dos admins

# ── Remarketing de PIX pendente ─────────────────────────────
LEMBRETE_MINUTOS=30              # lembrete com o mesmo PIX
CUPOM_REMARKETING_MINUTOS=1440   # 24h depois: cupom pessoal
CUPOM_REMARKETING_PCT=15
CUPOM_REMARKETING_VALIDADE_HORAS=48
REMARKETING_INTERVALO_SEG=60     # de quanto em quanto tempo o job roda

# ── Admin ───────────────────────────────────────────────────
BROADCAST_POR_SEGUNDO=25         # limite do Telegram é ~30/s
FUSO_HORARIO=America/Sao_Paulo   # usado no /stats ("hoje")

# ── Outros ──────────────────────────────────────────────────
DB_PATH=bot.db
BLUR_RADIUS=20
